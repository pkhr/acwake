#!/bin/bash
# acwake — keep macOS awake on AC; sleep normally on battery.
# Wraps `caffeinate -s` (kIOPMAssertPreventSystemSleep, AC-scoped by the kernel).
# Display sleep, screen saver, dim, and lock all behave as configured.
# https://github.com/pkhr/acwake

set -euo pipefail

case "${1:-}" in
  run)
    exec caffeinate -s
    ;;
  status)
    pmset -g ps | head -1
    if pmset -g assertions | grep -qi PreventSystemSleep; then
      echo "PreventSystemSleep: active"
    else
      echo "PreventSystemSleep: not held"
    fi
    ;;
  *)
    cat <<USAGE
acwake — stay awake on AC, sleep on battery (macOS)

  $(basename "$0") run     daemon mode (used by brew services)
  $(basename "$0") status  show power source and assertion state

Install:
  brew tap pkhr/tap
  brew install acwake
  sudo brew services start acwake

Uninstall:
  sudo brew services stop acwake
  brew uninstall acwake
  brew untap pkhr/tap
USAGE
    exit 2 ;;
esac
